#!/usr/bin/env bash
# Benchmark the adaptive root cut-generator skip feature
# (CBC_CUT_ADAPTIVE_SKIP env var) using the REAL cbc CLI end-to-end
# (full preprocessing + root LP solve + cut generation + first 16 nodes),
# not mip-root-replay's fixture path.
#
# NOTE: mip-root-replay/CbcStrategyDefault currently sets up cut
# generators differently than CbcSolver.cpp's actual CLI defaults (see
# CbcSolver.cpp ~line 7271-7322, which calls CbcModel::addCutGenerator
# directly with its own howOften/threshold values, never going through
# CbcStrategyDefault::setupCutGenerators at all) -- confirmed by instrumenting
# the adaptive-skip streak counter: it fires constantly on the real `cbc`
# binary (e.g. Probing enters backoff after 3 consecutive misses on
# noswot) but never once across all 442 fixtures when driven through
# mip-root-replay. So for now this benchmarks the real CLI directly,
# paying the full preprocessing+root-LP-solve cost per run (the very cost
# the fixture infrastructure was meant to let us skip) until
# mip-root-replay's generator setup is fixed to match CbcSolver.cpp
# exactly (tracked as follow-up work, not done here).
#
# Usage:
#   ./bench-adaptive-cutskip-cli [--jobs=N] [--sec=N] [--out=DIR] [--instances=FILE]
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CBC_BIN="$SCRIPT_DIR/../src/cbc"
DATA_DIR="$SCRIPT_DIR/mip-sanity-data"
FIXTURE_DIR="${CBC_ROOT_FIXTURE_DIR:-$HOME/instances/mip-sanity-data/rootFixtures}"

if [[ "${1:-}" == --worker=* ]]; then
  inst="${1#--worker=}"
  variant="$2"
  sec="$3"
  if [[ "$variant" == adaptive ]]; then
    export CBC_CUT_ADAPTIVE_SKIP=1
  else
    unset CBC_CUT_ADAPTIVE_SKIP
  fi
  mps="$DATA_DIR/mips/$inst.mps.gz"
  if [[ ! -f "$mps" ]]; then
    printf '%s\tERROR\tno-mps\n' "$inst"
    exit 0
  fi
  t0=$(date +%s.%N)
  out="$(timeout -k 5 "$((sec + 15))s" "$CBC_BIN" "$mps" -threads 1 -maxNodes 16 -sec "$sec" -solve 2>&1)"
  rc=$?
  t1=$(date +%s.%N)
  elapsed=$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.4f", b-a}')
  result_line="$(grep '^Result - ' <<<"$out" | tail -1)"
  obj="$(grep '^Objective value:' <<<"$out" | tail -1 | awk '{print $NF}')"
  bound="$(grep '^Lower bound:' <<<"$out" | tail -1 | awk '{print $NF}')"
  nodes="$(grep '^Enumerated nodes:' <<<"$out" | tail -1 | awk '{print $NF}')"
  if [[ $rc -ne 0 || -z "$result_line" ]]; then
    printf '%s\tERROR\trc=%s\n' "$inst" "$rc"
    exit 0
  fi
  # If optimal/feasible-with-no-gap, cbc doesn't print "Lower bound:" --
  # the objective itself is also the proven bound in that case.
  [[ -z "$bound" ]] && bound="$obj"
  [[ -z "$obj" ]] && obj="none"
  [[ -z "$nodes" ]] && nodes="0"
  printf '%s\t%s\t%s\t%s\t%s\n' "$inst" "$nodes" "$obj" "$bound" "$elapsed"
  exit 0
fi

JOBS=64
SEC=240
OUT_DIR="$SCRIPT_DIR/sanity-results/cutskip-bench-cli"
INSTANCES_FILE=""

for arg in "$@"; do
  case "$arg" in
    --jobs=*) JOBS="${arg#*=}" ;;
    --sec=*) SEC="${arg#*=}" ;;
    --out=*) OUT_DIR="${arg#*=}" ;;
    --instances=*) INSTANCES_FILE="${arg#*=}" ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

mkdir -p "$OUT_DIR"

if [[ -n "$INSTANCES_FILE" ]]; then
  mapfile -t INSTANCES < "$INSTANCES_FILE"
else
  mapfile -t INSTANCES < <(ls "$FIXTURE_DIR"/*.root.meta 2>/dev/null | sed 's#.*/##; s/\.root\.meta$//' | sort)
fi
echo "${#INSTANCES[@]} instances, jobs=$JOBS sec=$SEC out=$OUT_DIR" >&2

HEADER='instance\tnodes\tobj\tbound\telapsed'
for variant in base adaptive; do
  echo "=== running variant: $variant (real cbc CLI) ===" >&2
  echo -e "$HEADER" > "$OUT_DIR/$variant.tsv.tmp"
  printf '%s\n' "${INSTANCES[@]}" | \
    parallel --will-cite -j "$JOBS" --line-buffer \
      "$SCRIPT_DIR/$(basename "$0")" --worker={} "$variant" "$SEC" \
      >> "$OUT_DIR/$variant.tsv.tmp"
  mv "$OUT_DIR/$variant.tsv.tmp" "$OUT_DIR/$variant.tsv"
  n_err=$(grep -c 'ERROR' "$OUT_DIR/$variant.tsv" || true)
  echo "variant $variant done: $(( $(wc -l < "$OUT_DIR/$variant.tsv") - 1 )) rows, $n_err errors" >&2
done
echo "Done. Results in $OUT_DIR/{base,adaptive}.tsv" >&2
