#!/usr/bin/env bash
# run-mip-sanity-tests — mip-sanity-data regression suite for Cbc.
#
# Self-contained in the Cbc repository (works from a standalone `Cbc` clone,
# on the `next` branch, once Cbc itself has been configured/built): solves
# every instance in the `test/mip-sanity-data` submodule with `cbc` (one
# thread per run), applying the suggested node/time limits from
# `limits.tsv`, running up to `--jobs` instances in parallel (default:
# number of processors). Each run's best solution is saved to a `.sol` file
# and then checked by `cbc_validate_sol` (built from
# test/cbc_validate_sol.cpp) for:
#   - primal feasibility (variable bounds, integrality, constraint activity)
#   - objective value consistency (recomputed vs claimed, within tolerance)
#   - optimality claims cross-checked against `bks.tsv` best-known values
#   - infeasibility claims cross-checked against `bks.tsv`
#
# Usage (from the `test/` directory, or via `make test` / `make -C test test`):
#   ./run-mip-sanity-tests [OPTIONS] [instance-glob ...]
#
# Options:
#   --jobs=N            Parallel jobs (default: $CBC_TESTS_JOBS env var if set,
#                        otherwise nproc)
#   --cbc=PATH           Path to the cbc executable (default: ../src/cbc built
#                        in-tree, falling back to $PREFIX/bin/cbc and $PATH)
#   --prefix=PATH        Install prefix to look for cbc in (default: ~/prog/cbc)
#   --data-dir=PATH      mip-sanity-data checkout (default: ./mip-sanity-data,
#                        i.e. the test/mip-sanity-data submodule)
#   --results-dir=PATH   Where to write logs/.sol files (default: ./sanity-results)
#   --results-tsv=PATH   Where to save a per-instance results table (tab-separated:
#                        instance, status, elapsed_s, nodes, gap_pct, is_optimal,
#                        obj, bound) for later comparison across runs (default:
#                        <results-dir>/results.tsv). Pass a different path (e.g.
#                        --results-tsv=after-change.tsv) to keep a baseline around
#                        and compare it against a later run, e.g.:
#                          diff <(sort baseline.tsv) <(sort after-change.tsv)
#   --update-data        Force `git submodule update` for mip-sanity-data before running
#   --no-color           Disable ANSI colors
#   -h, --help           Show this help
#
# Positional arguments (optional): one or more glob patterns to select a
# subset of instances by name (e.g. `./run-mip-sanity-tests 'jssp_*' 'cvrp_*'`).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
JOBS="${CBC_TESTS_JOBS:-$(nproc)}"
PREFIX="${PREFIX:-$HOME/prog/cbc}"
DATA_DIR="$SCRIPT_DIR/mip-sanity-data"
RESULTS_DIR="$SCRIPT_DIR/sanity-results"
RESULTS_TSV=""
CBC_BIN_OVERRIDE=""
UPDATE_DATA=0
FORCE_COLOR=1
PATTERNS=()

for arg in "$@"; do
  case "$arg" in
    --jobs=*) JOBS="${arg#*=}" ;;
    --cbc=*) CBC_BIN_OVERRIDE="${arg#*=}" ;;
    --prefix=*) PREFIX="${arg#*=}" ;;
    --data-dir=*) DATA_DIR="${arg#*=}" ;;
    --results-dir=*) RESULTS_DIR="${arg#*=}" ;;
    --results-tsv=*) RESULTS_TSV="${arg#*=}" ;;
    --update-data) UPDATE_DATA=1 ;;
    --no-color) FORCE_COLOR=0 ;;
    -h|--help)
      sed -n '2,40p' "$0"
      exit 0
      ;;
    -*)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
    *) PATTERNS+=("$arg") ;;
  esac
done

# ── ANSI colours (auto-disabled when not a terminal) ────────────────────────
if [[ -t 1 && $FORCE_COLOR -eq 1 ]]; then
  BOLD=$'\e[1m';  RESET=$'\e[0m';   DIM=$'\e[2m'
  RED=$'\e[31m';  GREEN=$'\e[32m';  YELLOW=$'\e[33m'
  CYAN=$'\e[36m'; MAGENTA=$'\e[35m'; BLUE=$'\e[34m'
else
  BOLD=''; RESET=''; DIM=''; RED=''; GREEN=''
  YELLOW=''; CYAN=''; MAGENTA=''; BLUE=''
fi
# Exported so GNU parallel workers (separate bash processes) see them too.
export BOLD RESET DIM RED GREEN YELLOW CYAN MAGENTA BLUE

echo "${BOLD}=== Cbc mip-sanity-data regression suite (jobs=$JOBS) ===${RESET}"

# ── 1. Ensure mip-sanity-data is available (clone once, reuse afterwards) ───
if [[ ! -f "$REPO_ROOT/.gitmodules" ]] || ! grep -q "mip-sanity-data" "$REPO_ROOT/.gitmodules"; then
  echo "${RED}Error: test/mip-sanity-data submodule not declared in .gitmodules.${RESET}" >&2
  exit 1
fi

if [[ ! -f "$DATA_DIR/bks.tsv" ]]; then
  echo "${YELLOW}mip-sanity-data not yet checked out — cloning (one-time)...${RESET}"
  git -C "$REPO_ROOT" submodule update --init "test/mip-sanity-data"
elif [[ $UPDATE_DATA -eq 1 ]]; then
  echo "${CYAN}Updating mip-sanity-data submodule...${RESET}"
  git -C "$REPO_ROOT" submodule update "test/mip-sanity-data"
else
  echo "${DIM}mip-sanity-data already checked out at $DATA_DIR (reusing; use --update-data to refresh)${RESET}"
fi

if [[ ! -f "$DATA_DIR/bks.tsv" ]]; then
  echo "${RED}Error: $DATA_DIR/bks.tsv not found after checkout.${RESET}" >&2
  exit 1
fi

# ── 2. Locate the cbc executable ────────────────────────────────────────────
CBC_BIN=""
if [[ -n "$CBC_BIN_OVERRIDE" ]]; then
  CBC_BIN="$CBC_BIN_OVERRIDE"
elif [[ -x "$SCRIPT_DIR/../src/cbc" ]]; then
  CBC_BIN="$SCRIPT_DIR/../src/cbc"          # in-tree build (preferred: always current)
elif [[ -x "$PREFIX/bin/cbc" ]]; then
  CBC_BIN="$PREFIX/bin/cbc"
elif command -v cbc >/dev/null 2>&1; then
  CBC_BIN="$(command -v cbc)"
fi
if [[ -z "$CBC_BIN" || ! -x "$CBC_BIN" ]]; then
  echo "${RED}Error: cbc executable not found (looked in ../src/cbc, $PREFIX/bin, \$PATH).${RESET}" >&2
  echo "       Build Cbc first (e.g. 'make' at the repo root, or via cbc-workspace's ./config)." >&2
  exit 1
fi
echo "${DIM}Using cbc: $CBC_BIN${RESET}"

# ── 3. Locate/build the validator ───────────────────────────────────────────
VALIDATOR="$SCRIPT_DIR/cbc_validate_sol"
if [[ ! -x "$VALIDATOR" ]]; then
  echo "${CYAN}Building cbc_validate_sol...${RESET}"
  if [[ ! -f "$SCRIPT_DIR/Makefile" ]]; then
    echo "${RED}Error: test/Makefile missing — configure Cbc first ('./configure' at the repo root).${RESET}" >&2
    exit 1
  fi
  make -C "$SCRIPT_DIR" cbc_validate_sol || {
    echo "${RED}Error: failed to build cbc_validate_sol.${RESET}" >&2
    exit 1
  }
fi
echo "${DIM}Using validator: $VALIDATOR${RESET}"

# ── 4. Build the instance list ──────────────────────────────────────────────
mkdir -p "$RESULTS_DIR"
[[ -z "$RESULTS_TSV" ]] && RESULTS_TSV="$RESULTS_DIR/results.tsv"
shopt -s nullglob
all_instances=()
for f in "$DATA_DIR"/mips/*.mps.gz; do
  name="$(basename "$f" .mps.gz)"
  all_instances+=("$name")
done
shopt -u nullglob

if [[ ${#all_instances[@]} -eq 0 ]]; then
  echo "${RED}Error: no instances found under $DATA_DIR/mips.${RESET}" >&2
  exit 1
fi

instances=()
if [[ ${#PATTERNS[@]} -eq 0 ]]; then
  instances=("${all_instances[@]}")
else
  for name in "${all_instances[@]}"; do
    for pat in "${PATTERNS[@]}"; do
      # shellcheck disable=SC2053
      if [[ "$name" == $pat ]]; then
        instances+=("$name")
        break
      fi
    done
  done
fi

echo "${BOLD}${#instances[@]} instance(s) selected (of ${#all_instances[@]} total).${RESET}"
echo

# ── 5. Per-instance runner ───────────────────────────────────────────────────
# Both are exported so GNU parallel workers (separate bash processes) can call them.

# Parses a cbc log for both a human-readable one-line summary and the
# machine-readable fields needed for suite-wide statistics. Cbc always prints
# classic "Result - ...\nObjective value: ...\nEnumerated nodes: ..." lines
# (optionally "Lower bound:"/"Gap:" when a gap remains) for every outcome
# except infeasible/unbounded detected during presolve/root (handled below) —
# these are more robust to parse than cbc's fancier colored summary line,
# which is omitted entirely for instances solved during presolve/root.
#
# Prints one pipe-delimited record: status_text|obj|bound|gap_pct|nodes|is_optimal|has_solution
#   is_optimal   = 1 if Cbc's own claimed status is an optimality proof
#   has_solution = 1 if an integer-feasible incumbent was reported at all
#                  (0 for proven-infeasible/unbounded and "Integer infeasible")
parse_cbc_log() {
  local log="$1"
  local result_line status_text obj nodes bound gap
  result_line="$(grep "^Result - " "$log" 2>/dev/null | tail -1)"
  if [[ -z "$result_line" ]]; then
    if grep -q "Problem is infeasible" "$log" 2>/dev/null; then
      echo "Infeasible (detected in presolve/root)||||0|0|0"
    elif grep -q "Problem is unbounded" "$log" 2>/dev/null; then
      echo "Unbounded (detected in presolve/root)||||0|0|0"
    else
      echo "||||0|0|0"
    fi
    return
  fi
  status_text="${result_line#Result - }"
  obj="$(grep "^Objective value:" "$log" 2>/dev/null | tail -1 | awk '{print $NF}')"
  nodes="$(grep "^Enumerated nodes:" "$log" 2>/dev/null | tail -1 | awk '{print $NF}')"
  bound="$(grep "^Lower bound:" "$log" 2>/dev/null | tail -1 | awk '{print $NF}')"
  gap="$(grep "^Gap:" "$log" 2>/dev/null | tail -1 | awk '{print $NF}')"

  local gap_pct=""
  if [[ -n "$gap" ]]; then
    gap_pct="$(awk -v g="$gap" 'BEGIN{printf "%.4f", g*100}' 2>/dev/null)"
  fi

  local is_optimal=0 has_solution=1
  [[ "$status_text" == Optimal* ]] && is_optimal=1
  [[ "$status_text" == "Integer infeasible" ]] && has_solution=0

  echo "${status_text}|${obj}|${bound}|${gap_pct}|${nodes:-0}|${is_optimal}|${has_solution}"
}
export -f parse_cbc_log

run_one() {
  local name="$1"
  local data_dir="$2" results_dir="$3" cbc_bin="$4" validator="$5" total="$6"
  local progress_count_file="$7" progress_lock="$8"

  local mps="$data_dir/mips/$name.mps.gz"
  local sol="$results_dir/$name.sol"
  local cbc_log="$results_dir/$name.cbc.log"
  local val_log="$results_dir/$name.validate.log"
  local status_file="$results_dir/$name.status"

  # ── read suggested limits (default: unlimited nodes, 120s/180s hard-kill) ──
  local node_limit=0 time_limit=120 hard_kill=180
  local limits_row
  limits_row="$(awk -F'\t' -v n="$name" '$1==n{print $3"\t"$4"\t"$5; found=1} END{if(!found) exit 1}' "$data_dir/limits.tsv" 2>/dev/null)"
  if [[ -n "$limits_row" ]]; then
    IFS=$'\t' read -r node_limit time_limit hard_kill <<<"$limits_row"
  fi

  # ── read bks (expected status/objective) ───────────────────────────────────
  local bks_row expected_status="" expected_obj=""
  bks_row="$(awk -F'\t' -v n="$name" '$1==n{print $2"\t"$3; found=1} END{if(!found) exit 1}' "$data_dir/bks.tsv" 2>/dev/null)"
  if [[ -n "$bks_row" ]]; then
    IFS=$'\t' read -r expected_status expected_obj <<<"$bks_row"
  fi

  local node_args=()
  if [[ "$node_limit" != "0" ]]; then
    node_args=(-maxNodes "$node_limit")
  fi

  # Prints one progress line as soon as this instance is done (visible while
  # the rest of the suite is still running) and records the outcome for the
  # final summary/failure-detail pass. $summary is filled in below, once the
  # cbc log exists. done_count is tracked via a dedicated per-run counter file
  # (not by globbing *.status in results_dir, which may still hold stale
  # entries from an earlier/broader run) so the "[n/total]" prefix is exact.
  emit() {
    local kind="$1" note="$2"
    echo "$kind|$elapsed|$note|$summary|$is_optimal|$gap_metric|$nodes|$status_text|$obj|$bound|$gap_pct" >"$status_file"

    local done_count
    done_count=$( { flock -x 9
      local c
      c=$(<"$progress_count_file")
      c=$((c + 1))
      echo "$c" >"$progress_count_file"
      echo "$c"
    } 9>"$progress_lock" )

    local icon color
    case "$kind" in
      PASS) icon="✔"; color="$GREEN" ;;
      OVERTIME) icon="⏱"; color="$YELLOW" ;;
      *) icon="✗"; color="$RED" ;;
    esac

    local line
    line="${DIM}[$(printf '%3d' "$done_count")/${total}]${RESET} ${color}${icon} ${name}${RESET}  ${DIM}(${elapsed}s)${RESET}"
    [[ -n "$summary" ]] && line="${line}  ${summary}"
    [[ -n "$note" ]] && line="${line}  ${color}${note}${RESET}"
    printf '%s\n' "$line"
  }

  local start_ts end_ts elapsed
  start_ts=$(date +%s.%N)
  # cbc's "-solu <file>" appends to an existing file rather than truncating
  # it, so a stale .sol left over from an earlier run of this same instance
  # (e.g. a previous ./test invocation against the same results dir) would
  # otherwise accumulate multiple concatenated solution blocks, which the
  # validator can misparse as a corrupt/partial solution and report as a
  # false failure. Always start from a clean file.
  rm -f "$sol"
  timeout -k 10 "${hard_kill}s" "$cbc_bin" "$mps" -threads 1 -sec "$time_limit" \
    "${node_args[@]}" -solve -solu "$sol" >"$cbc_log" 2>&1
  local cbc_rc=$?
  end_ts=$(date +%s.%N)
  elapsed="$(awk -v a="$start_ts" -v b="$end_ts" 'BEGIN{printf "%.1f", b-a}')"

  # ── parse the log once: human summary line + machine fields for stats ──────
  local parsed status_text obj bound gap_pct nodes is_optimal has_solution
  parsed="$(parse_cbc_log "$cbc_log")"
  IFS='|' read -r status_text obj bound gap_pct nodes is_optimal has_solution <<<"$parsed"
  nodes="${nodes:-0}"

  local summary=""
  if [[ -n "$status_text" ]]; then
    summary="$status_text"
    [[ -n "$obj" ]] && summary="${summary}  obj=${obj}"
    [[ -n "$bound" ]] && summary="${summary}  bound=${bound}"
    if [[ -n "$gap_pct" ]]; then
      summary="${summary}  gap=$(awk -v g="$gap_pct" 'BEGIN{printf "%.2f", g}')%"
    fi
    [[ -n "$nodes" ]] && summary="${summary}  nodes=${nodes}"
  fi

  # ── gap metric for suite-wide averaging: optimal=0, feasible=min(gap,100),
  #     no feasible solution at all=200 ───────────────────────────────────────
  local gap_metric
  if [[ "$is_optimal" == "1" ]]; then
    gap_metric=0
  elif [[ "$has_solution" == "1" && -n "$gap_pct" ]]; then
    gap_metric="$(awk -v g="$gap_pct" 'BEGIN{v=g; if(v<0) v=-v; if(v>100) v=100; printf "%.4f", v}')"
  elif [[ "$has_solution" == "1" ]]; then
    gap_metric=100   # solution found but gap/bound unavailable — conservative cap
  else
    gap_metric=200   # no integer-feasible solution at all (or run never completed)
  fi

  if [[ $cbc_rc -eq 124 || $cbc_rc -eq 137 ]]; then
    emit OVERTIME "hard-kill (${hard_kill}s) triggered — cbc did not respect its own -sec limit"
    return
  fi
  if [[ ! -f "$sol" ]]; then
    emit ERROR "cbc exited (rc=$cbc_rc) without writing a .sol file"
    return
  fi

  local val_args=(-p 1e-4 -i 1e-4 -o 1e-4 --bks-abs-tol 1e-4 --bks-pct-tol 0.01)
  if [[ -n "$expected_status" ]]; then
    val_args+=(--expected-status "$expected_status")
  fi
  if [[ -n "$expected_obj" && "$expected_obj" != "NA" ]]; then
    val_args+=(--expected-obj "$expected_obj")
  fi

  "$validator" "${val_args[@]}" "$mps" "$sol" >"$val_log" 2>&1
  local val_rc=$?

  if [[ $val_rc -eq 0 ]]; then
    emit PASS ""
  else
    local fail_reason
    fail_reason="$(grep -m1 -E "MISMATCH|^  BOUND:|^  INTEG:|^  ROW:|^  OBJ:" "$val_log")"
    fail_reason="${fail_reason#"${fail_reason%%[![:space:]]*}"}"  # ltrim
    [[ -z "$fail_reason" ]] && fail_reason="validation FAILED (exit=$val_rc)"
    emit FAIL "${fail_reason} — full details below"
  fi
}
export -f run_one

# ── 6. Dispatch in parallel (each job prints its own progress line live) ────
PROGRESS_COUNT_FILE="$(mktemp "${RESULTS_DIR}/.progress-count.XXXXXX")"
PROGRESS_LOCK="$(mktemp "${RESULTS_DIR}/.progress-lock.XXXXXX")"
echo 0 >"$PROGRESS_COUNT_FILE"
trap 'rm -f "$PROGRESS_COUNT_FILE" "$PROGRESS_LOCK"' EXIT

echo "${DIM}Running... (results stream in as instances finish; order is by completion, not by name)${RESET}"
printf '%s\n' "${instances[@]}" | parallel --will-cite -j "$JOBS" --line-buffer \
  run_one {} "$DATA_DIR" "$RESULTS_DIR" "$CBC_BIN" "$VALIDATOR" "${#instances[@]}" \
  "$PROGRESS_COUNT_FILE" "$PROGRESS_LOCK"
echo

# ── 7. Aggregate results from the .status files already printed above ──────
declare -a pass_list=() fail_list=() overtime_list=() error_list=()
STATS_FILE="$(mktemp "${RESULTS_DIR}/.run-stats.XXXXXX")"
trap 'rm -f "$PROGRESS_COUNT_FILE" "$PROGRESS_LOCK" "$STATS_FILE"' EXIT
: >"$STATS_FILE"
printf 'instance\tstatus\telapsed_s\tnodes\tgap_pct\tis_optimal\tobj\tbound\n' >"$RESULTS_TSV"
for name in "${instances[@]}"; do
  status_file="$RESULTS_DIR/$name.status"
  if [[ ! -f "$status_file" ]]; then
    echo "  ${RED}✗ ${name}${RESET}  ${DIM}(no status file — run_one crashed?)${RESET}"
    error_list+=("$name")
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "0" "0" "200" "0" >>"$STATS_FILE"
    printf '%s\tERROR\t0\t0\t\t0\t\t\n' "$name" >>"$RESULTS_TSV"
    continue
  fi
  IFS='|' read -r kind elapsed detail summary is_optimal gap_metric nodes status_text obj bound gap_pct <"$status_file"
  case "$kind" in
    PASS) pass_list+=("$name") ;;
    FAIL) fail_list+=("$name") ;;
    OVERTIME) overtime_list+=("$name") ;;
    ERROR) error_list+=("$name") ;;
    *)
      echo "  ${RED}✗ ${name}${RESET}  ${DIM}(unrecognized status: $kind)${RESET}"
      error_list+=("$name")
      ;;
  esac
  # "optimal solutions found" only counts claimed-optimal runs that also
  # passed validation (a claimed-optimal FAIL, e.g. an infeasible "optimal",
  # is not a real solution).
  is_optimal_confirmed=0
  [[ "$kind" == "PASS" && "$is_optimal" == "1" ]] && is_optimal_confirmed=1
  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "${elapsed:-0}" "${nodes:-0}" "${gap_metric:-200}" "$is_optimal_confirmed" >>"$STATS_FILE"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$name" "$kind" "${elapsed:-0}" "${nodes:-0}" "${gap_pct:-}" "$is_optimal_confirmed" "${obj:-}" "${bound:-}" >>"$RESULTS_TSV"
done
echo "${DIM}Per-instance results saved to $RESULTS_TSV${RESET}"

# One pass over the per-instance stats file to compute suite-wide aggregates:
# total runtime/nodes, average gap (see the per-instance gap_metric rule in
# run_one), how many were solved to a confirmed optimum, and which instance
# was slowest / processed the most nodes.
read -r total_runtime total_nodes avg_gap n_optimal slowest_name slowest_time maxnodes_name maxnodes_val <<<"$(
  awk -F'\t' '
    BEGIN { tot_time=0; tot_nodes=0; tot_gap=0; n=0; n_opt=0; slow_t=-1; slow_n="-"; maxnode_v=-1; maxnode_n="-" }
    {
      tot_time += $2; tot_nodes += $3; tot_gap += $4; n_opt += $5; n++
      if ($2+0 > slow_t)   { slow_t=$2+0;   slow_n=$1 }
      if ($3+0 > maxnode_v) { maxnode_v=$3+0; maxnode_n=$1 }
    }
    END {
      avg = (n > 0) ? tot_gap / n : 0
      printf "%.1f %d %.2f %d %s %.1f %s %d\n", tot_time, tot_nodes, avg, n_opt, slow_n, slow_t, maxnode_n, maxnode_v
    }
  ' "$STATS_FILE"
)"

# Adds thousands separators to a plain (non-negative) integer, e.g. 12345 -> 12,345.
with_commas() {
  echo "$1" | rev | sed -E 's/([0-9]{3})/\1,/g' | rev | sed -E 's/^,//'
}

# Prints one plain (uncolored) two-column row; colored by wrapping the whole
# line afterwards, since padding a colored substring with %-Ns miscounts the
# invisible ANSI escape bytes.
row() { printf "  %-26s %14s" "$1" "$2"; }
rule() { printf "  %s" "$(printf -- '─%.0s' $(seq 1 40))"; }

echo
echo "${BOLD}=== Summary ===${RESET}"
echo "${BOLD}$(row "Result" "Count")${RESET}"
rule; echo
echo "${GREEN}$(row "Passed" "${#pass_list[@]}")${RESET}"
echo "${RED}$(row "Failed" "${#fail_list[@]}")${RESET}"
echo "${YELLOW}$(row "Overtime" "${#overtime_list[@]}")${RESET}"
echo "${RED}$(row "Error" "${#error_list[@]}")${RESET}"
rule; echo
echo "${BOLD}$(row "Total" "${#instances[@]}")${RESET}"
echo

echo "${BOLD}=== Solve statistics ===${RESET}"
echo "${BOLD}$(row "Metric" "Value")${RESET}"
rule; echo
echo "$(row "Optimal solutions found" "$n_optimal / ${#instances[@]}")"
echo "$(row "Total runtime" "${total_runtime}s")"
echo "$(row "Total nodes processed" "$(with_commas "$total_nodes")")"
echo "$(row "Average gap" "${avg_gap}%")"
echo
if [[ "$slowest_name" != "-" ]]; then
  echo "  Slowest instance:          ${slowest_name}  (${slowest_time}s)"
fi
if [[ "$maxnodes_name" != "-" ]]; then
  echo "  Most nodes processed:      ${maxnodes_name}  ($(with_commas "$maxnodes_val") nodes)"
fi
echo

# ── 8. Full details for anything that didn't pass ───────────────────────────
report_failure() {
  local name="$1"
  echo "${BOLD}${RED}─── $name ─────────────────────────────────────────────${RESET}"
  echo "${CYAN}-- cbc log ($RESULTS_DIR/$name.cbc.log) --${RESET}"
  tail -n 60 "$RESULTS_DIR/$name.cbc.log" 2>/dev/null
  echo
  if [[ -f "$RESULTS_DIR/$name.validate.log" ]]; then
    echo "${CYAN}-- validator output ($RESULTS_DIR/$name.validate.log) --${RESET}"
    cat "$RESULTS_DIR/$name.validate.log"
  fi
  echo
}

if [[ ${#fail_list[@]} -gt 0 || ${#error_list[@]} -gt 0 ]]; then
  echo "${BOLD}${RED}=== Failure details ===${RESET}"
  for name in "${fail_list[@]}" "${error_list[@]}"; do
    report_failure "$name"
  done
fi

if [[ ${#overtime_list[@]} -gt 0 ]]; then
  echo "${BOLD}${YELLOW}=== Instances that went overtime (hard-kill triggered; limits.tsv may need adjusting) ===${RESET}"
  for name in "${overtime_list[@]}"; do
    echo "  - $name"
  done
  echo
fi

if [[ ${#fail_list[@]} -gt 0 || ${#error_list[@]} -gt 0 ]]; then
  exit 1
fi
exit 0
