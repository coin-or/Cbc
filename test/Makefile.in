	$(AM_V_CXXLD)$(CXXLINK) $(row_activity_test_OBJECTS) $(row_activity_test_LDADD) $(LIBS)

rowred-test$(EXEEXT): $(rowred_test_OBJECTS) $(rowred_test_DEPENDENCIES) $(EXTRA_rowred_test_DEPENDENCIES) 
	@rm -f rowred-test$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(rowred_test_OBJECTS) $(rowred_test_LDADD) $(LIBS)

