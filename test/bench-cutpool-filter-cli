#!/usr/bin/env bash
# Benchmark the CoinCutPool candidate-count-gated filtering change
# (CglBKClique/CglOddWheel/CglImpliedClique) using the REAL cbc CLI
# end-to-end (full preprocessing + root LP solve + cut generation + first
# 16 nodes), same methodology as bench-adaptive-cutskip-cli.
#
# Variants:
#   base       - force the ORIGINAL always-filter behaviour
#                (CBC_CLIQUE_POOL_ALWAYS_FILTER=1), i.e. pre-change control.
#   gated      - new default: threshold-gated filtering
#                (CBC_CLIQUE_POOL_MIN_CANDIDATES=20, _MIN_COLS=500).
#   gated-cN   - new behaviour with CBC_CLIQUE_POOL_MIN_CANDIDATES=N, for
#                sweeping the candidate-count threshold.
#
# Usage:
#   ./bench-cutpool-filter-cli [--jobs=N] [--sec=N] [--out=DIR] [--instances=FILE] [--variants=base,gated]
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CBC_BIN="$SCRIPT_DIR/../src/cbc"
DATA_DIR="$SCRIPT_DIR/mip-sanity-data"
FIXTURE_DIR="${CBC_ROOT_FIXTURE_DIR:-$HOME/instances/mip-sanity-data/rootFixtures}"

if [[ "${1:-}" == --worker=* ]]; then
  inst="${1#--worker=}"
  variant="$2"
  sec="$3"
  unset CBC_CLIQUE_POOL_ALWAYS_FILTER CBC_CLIQUE_POOL_MIN_CANDIDATES CBC_CLIQUE_POOL_MIN_COLS
  if [[ "$variant" == "base" ]]; then
    export CBC_CLIQUE_POOL_ALWAYS_FILTER=1
  elif [[ "$variant" == gated-c* ]]; then
    export CBC_CLIQUE_POOL_MIN_CANDIDATES="${variant#gated-c}"
  elif [[ "$variant" == "gated" ]]; then
    : # new defaults, no env override needed
  fi
  mps="$DATA_DIR/mips/$inst.mps.gz"
  if [[ ! -f "$mps" ]]; then
    printf '%s\tERROR\tno-mps\n' "$inst"
    exit 0
  fi
  t0=$(date +%s.%N)
  out="$(timeout -k 5 "$((sec + 15))s" "$CBC_BIN" "$mps" -threads 1 -maxNodes 16 -sec "$sec" -solve 2>&1)"
  rc=$?
  t1=$(date +%s.%N)
  elapsed=$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.4f", b-a}')
  result_line="$(grep '^Result - ' <<<"$out" | tail -1)"
  obj="$(grep '^Objective value:' <<<"$out" | tail -1 | awk '{print $NF}')"
  bound="$(grep '^Lower bound:' <<<"$out" | tail -1 | awk '{print $NF}')"
  nodes="$(grep '^Enumerated nodes:' <<<"$out" | tail -1 | awk '{print $NF}')"
  if [[ $rc -ne 0 || -z "$result_line" ]]; then
    printf '%s\tERROR\trc=%s\n' "$inst" "$rc"
    exit 0
  fi
  [[ -z "$bound" ]] && bound="$obj"
  [[ -z "$obj" ]] && obj="none"
  [[ -z "$nodes" ]] && nodes="0"
  printf '%s\t%s\t%s\t%s\t%s\n' "$inst" "$nodes" "$obj" "$bound" "$elapsed"
  exit 0
fi

JOBS=64
SEC=240
OUT_DIR="$SCRIPT_DIR/sanity-results/cutpool-filter-bench-cli"
INSTANCES_FILE=""
VARIANTS="base,gated"

for arg in "$@"; do
  case "$arg" in
    --jobs=*) JOBS="${arg#*=}" ;;
    --sec=*) SEC="${arg#*=}" ;;
    --out=*) OUT_DIR="${arg#*=}" ;;
    --instances=*) INSTANCES_FILE="${arg#*=}" ;;
    --variants=*) VARIANTS="${arg#*=}" ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

mkdir -p "$OUT_DIR"

if [[ -n "$INSTANCES_FILE" ]]; then
  mapfile -t INSTANCES < "$INSTANCES_FILE"
else
  mapfile -t INSTANCES < <(ls "$FIXTURE_DIR"/*.root.meta 2>/dev/null | sed 's#.*/##; s/\.root\.meta$//' | sort)
fi
echo "${#INSTANCES[@]} instances, jobs=$JOBS sec=$SEC out=$OUT_DIR variants=$VARIANTS" >&2

IFS=',' read -r -a VARIANT_LIST <<< "$VARIANTS"
HEADER='instance\tnodes\tobj\tbound\telapsed'
for variant in "${VARIANT_LIST[@]}"; do
  echo "=== running variant: $variant (real cbc CLI) ===" >&2
  echo -e "$HEADER" > "$OUT_DIR/$variant.tsv.tmp"
  printf '%s\n' "${INSTANCES[@]}" | \
    parallel --will-cite -j "$JOBS" --line-buffer \
      "$SCRIPT_DIR/$(basename "$0")" --worker={} "$variant" "$SEC" \
      >> "$OUT_DIR/$variant.tsv.tmp"
  mv "$OUT_DIR/$variant.tsv.tmp" "$OUT_DIR/$variant.tsv"
  n_err=$(grep -c 'ERROR' "$OUT_DIR/$variant.tsv" || true)
  echo "variant $variant done: $(( $(wc -l < "$OUT_DIR/$variant.tsv") - 1 )) rows, $n_err errors" >&2
done
echo "Done. Results in $OUT_DIR/{base,gated}.tsv" >&2
